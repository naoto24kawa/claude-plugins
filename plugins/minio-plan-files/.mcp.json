{
  "minio-plan-files": {
    "command": "bash",
    "args": ["-c", "cd \"${CLAUDE_PLUGIN_ROOT}/mcp-server\" && [ -d node_modules ] || npm install --silent 2>&1 && exec node index.js"],
    "env": {
      "MINIO_SHARED_PLAN_FILES_HOST": "${MINIO_SHARED_PLAN_FILES_HOST}",
      "MINIO_SHARED_PLAN_FILES_PROJECT": "${MINIO_SHARED_PLAN_FILES_PROJECT}",
      "PLAN_BUCKET": "${PLAN_BUCKET}"
    }
  }
}
